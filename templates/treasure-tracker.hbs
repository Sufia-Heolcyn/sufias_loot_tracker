<div class="pf2e-treasure-tracker">
  <nav class="level-tabs" aria-label="Party Levels 1 to 20">
    {{#each levels}}
      <button type="button"
              class="level-tab {{#if this.active}}active{{/if}}"
              data-action="selectLevel"
              data-level="{{this.level}}">
        Lv {{this.level}}
      </button>
    {{/each}}
  </nav>

  <header class="treasure-toolbar">
    <div class="prescription-summary">
      <h2>Level {{activeLevel}} Treasure Budget ({{prescription.totalGp}} gp Total)</h2>
      <p>Target Currency: {{prescription.currencyGp}} gp (+{{prescription.extraPcGp}} gp per additional PC)</p>
    </div>
    <div class="toolbar-actions">
      <button type="button" class="btn-roll" data-action="generateRandomLoot" data-currency-mode="gp">
        <i class="fa-solid fa-dice-d20"></i> Generate Random Loot (GP)
      </button>
      <button type="button" class="btn-roll secondary" data-action="generateRandomLoot" data-currency-mode="treasure">
        <i class="fa-solid fa-gem"></i> Generate Loot (Treasure Items)
      </button>
    </div>
  </header>

  <section class="loot-container">
    <h3>Mandatory Permanent Items</h3>
    <div class="slot-list">
      {{#each levelData.permanentItems}}
        <div class="loot-row {{#if this.distributed}}is-distributed{{/if}}">
          <span class="slot-level">Lv {{this.level}}</span>
          <span class="slot-name">{{this.name}}</span>
          <code class="slot-uuid">{{this.uuid}}</code>
          <button type="button"
                  data-action="distributeItem"
                  data-category="permanentItems"
                  data-index="{{@index}}"
                  {{#if this.distributed}}disabled{{/if}}>
            {{#if this.distributed}}Distributed{{else}}Distribute{{/if}}
          </button>
        </div>
      {{/each}}
    </div>
  </section>

  <section class="loot-container">
    <h3>Mandatory Consumables</h3>
    <div class="slot-list">
      {{#each levelData.consumables}}
        <div class="loot-row {{#if this.distributed}}is-distributed{{/if}}">
          <span class="slot-level">Lv {{this.level}}</span>
          <span class="slot-name">{{this.name}}</span>
          <code class="slot-uuid">{{this.uuid}}</code>
          <button type="button"
                  data-action="distributeItem"
                  data-category="consumables"
                  data-index="{{@index}}"
                  {{#if this.distributed}}disabled{{/if}}>
            {{#if this.distributed}}Distributed{{else}}Distribute{{/if}}
          </button>
        </div>
      {{/each}}
    </div>
  </section>

  <section class="loot-container">
    <h3>Mandatory Currency / Valuables</h3>
    <div class="slot-list">
      {{#each levelData.currency}}
        <div class="loot-row {{#if this.distributed}}is-distributed{{/if}}">
          <span class="slot-level">{{this.type}}</span>
          <span class="slot-name">{{this.name}}</span>
          <code class="slot-uuid">{{this.uuid}}</code>
          <button type="button"
                  data-action="distributeItem"
                  data-category="currency"
                  data-index="{{@index}}"
                  {{#if this.distributed}}disabled{{/if}}>
            {{#if this.distributed}}Distributed{{else}}Distribute{{/if}}
          </button>
        </div>
      {{/each}}
    </div>
  </section>

  <section class="loot-container">
    <h3>Bonus Loot &amp; Extra GP</h3>
    <div class="bonus-loot-form">
      <input type="text" name="bonusName" placeholder="Item Name or GP description" />
      <input type="text" name="bonusInput" placeholder="Compendium UUID (optional)" />
      <input type="number" name="bonusLevel" min="0" max="20" value="{{activeLevel}}" />
      <button type="button" data-action="addBonusLoot">Add Bonus Slot</button>
    </div>
    <div class="slot-list">
      {{#each levelData.bonusLoot}}
        <div class="loot-row {{#if this.distributed}}is-distributed{{/if}}">
          <span class="slot-level">Lv {{this.level}}</span>
          <span class="slot-name">{{this.name}}</span>
          <code class="slot-uuid">{{this.uuid}}</code>
          <button type="button"
                  data-action="distributeItem"
                  data-category="bonusLoot"
                  data-index="{{@index}}"
                  {{#if this.distributed}}disabled{{/if}}>
            {{#if this.distributed}}Distributed{{else}}Distribute{{/if}}
          </button>
        </div>
      {{/each}}
    </div>
  </section>
</div>
