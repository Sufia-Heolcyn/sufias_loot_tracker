<div class="pf2e-treasure-tracker">
  <!-- 20-Tab Level Navigation (Level 1 - Level 20) -->
  <nav class="level-tabs" aria-label="Party Levels 1 to 20">
    {{#each levels}}
      <button type="button"
              class="level-tab {{#if this.active}}active{{/if}}"
              data-action="selectLevel"
              data-level="{{this.level}}">
        <span class="tab-lvl">Level {{this.level}}</span>
        <span class="tab-prog">{{this.progress}}</span>
      </button>
    {{/each}}
  </nav>

  <!-- Prescription Summary Header -->
  <header class="treasure-toolbar">
    <div class="prescription-summary">
      <h2>Level {{activeLevel}} Party Treasure Budget &mdash; {{prescription.totalGpFormatted}} gp Total</h2>
      <p>
        <strong>Permanent:</strong> {{prescription.permanentSummary}} &middot;
        <strong>Consumables:</strong> {{prescription.consumableSummary}} &middot;
        <strong>Currency:</strong> {{prescription.currencyGpFormatted}} gp (+{{prescription.extraPcGpFormatted}} gp / extra PC)
      </p>
      {{#if prescription.note}}
        <p class="prescription-note">* {{prescription.note}}</p>
      {{/if}}
    </div>
    <div class="drag-hint">
      <i class="fa-solid fa-hand-pointer"></i> Drag items into any Loot sheet, or drop compendium items into sections below
    </div>
  </header>

  <div class="treasure-sections-scroll">
    <!-- Container 1: Mandatory Permanent Items -->
    <section class="loot-container" data-drop-category="permanentItems">
      <div class="container-header">
        <div class="container-title-group">
          <h3>Mandatory Permanent Items</h3>
          <span class="container-subtitle">{{prescription.permanentSummary}}</span>
        </div>
        <button type="button" class="btn-section-roll" data-action="generatePermanent">
          <i class="fa-solid fa-dice-d20"></i> Generate Permanent Items
        </button>
      </div>
      <div class="slot-list">
        {{#each levelData.permanentItems}}
          <div class="loot-row {{#if this.distributed}}is-distributed{{/if}}"
               data-index="{{@index}}"
               {{#if this.uuid}}draggable="true" data-uuid="{{this.uuid}}"{{/if}}>
            <div class="slot-meta">
              <i class="fa-solid fa-grip-vertical drag-handle" title="Drag to Loot container"></i>
              <span class="slot-level">Lv {{this.level}}</span>
            </div>
            <div class="slot-main">
              {{#if this.uuid}}
                <a class="slot-name item-link" data-action="openItemSheet" data-uuid="{{this.uuid}}">{{this.name}}</a>
              {{else}}
                <span class="slot-name unrolled">{{this.name}}</span>
              {{/if}}
            </div>
            <span class="slot-price">{{this.price}}</span>
            <div class="row-actions">
              <button type="button"
                      class="btn-distribute"
                      data-action="distributeItem"
                      data-category="permanentItems"
                      data-index="{{@index}}"
                      {{#if this.distributed}}disabled{{/if}}>
                {{#if this.distributed}}Distributed{{else}}Distribute{{/if}}
              </button>
              {{#if this.distributed}}
                <button type="button"
                        class="btn-undo"
                        title="Undo distribution"
                        data-action="undoDistributeItem"
                        data-category="permanentItems"
                        data-index="{{@index}}">
                  <i class="fa-solid fa-rotate-left"></i>
                </button>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    </section>

    <!-- Container 2: Mandatory Consumables -->
    <section class="loot-container" data-drop-category="consumables">
      <div class="container-header">
        <div class="container-title-group">
          <h3>Mandatory Consumables</h3>
          <span class="container-subtitle">{{prescription.consumableSummary}}</span>
        </div>
        <button type="button" class="btn-section-roll" data-action="generateConsumables">
          <i class="fa-solid fa-dice-d20"></i> Generate Consumables
        </button>
      </div>
      <div class="slot-list">
        {{#each levelData.consumables}}
          <div class="loot-row {{#if this.distributed}}is-distributed{{/if}}"
               data-index="{{@index}}"
               {{#if this.uuid}}draggable="true" data-uuid="{{this.uuid}}"{{/if}}>
            <div class="slot-meta">
              <i class="fa-solid fa-grip-vertical drag-handle" title="Drag to Loot container"></i>
              <span class="slot-level">Lv {{this.level}}</span>
            </div>
            <div class="slot-main">
              {{#if this.uuid}}
                <a class="slot-name item-link" data-action="openItemSheet" data-uuid="{{this.uuid}}">{{this.name}}</a>
              {{else}}
                <span class="slot-name unrolled">{{this.name}}</span>
              {{/if}}
            </div>
            <span class="slot-price">{{this.price}}</span>
            <div class="row-actions">
              <button type="button"
                      class="btn-distribute"
                      data-action="distributeItem"
                      data-category="consumables"
                      data-index="{{@index}}"
                      {{#if this.distributed}}disabled{{/if}}>
                {{#if this.distributed}}Distributed{{else}}Distribute{{/if}}
              </button>
              {{#if this.distributed}}
                <button type="button"
                        class="btn-undo"
                        title="Undo distribution"
                        data-action="undoDistributeItem"
                        data-category="consumables"
                        data-index="{{@index}}">
                  <i class="fa-solid fa-rotate-left"></i>
                </button>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    </section>

    <!-- Container 3: Mandatory Currency / Valuables (Randomly Splits Treasure Items + GP) -->
    <section class="loot-container" data-drop-category="currency">
      <div class="container-header">
        <div class="container-title-group">
          <h3>Mandatory Currency / Valuables</h3>
          <span class="container-subtitle">{{prescription.currencyGpFormatted}} gp Total (Randomly splits Treasure Items &amp; GP)</span>
        </div>
        <button type="button" class="btn-section-roll" data-action="generateCurrency">
          <i class="fa-solid fa-coins"></i> Generate Currency &amp; Valuables
        </button>
      </div>
      <div class="slot-list">
        {{#each levelData.currency}}
          <div class="loot-row {{#if this.distributed}}is-distributed{{/if}}"
               data-index="{{@index}}"
               {{#if this.uuid}}draggable="true" data-uuid="{{this.uuid}}"{{/if}}>
            <div class="slot-meta">
              <i class="fa-solid fa-grip-vertical drag-handle" title="Drag to Loot container"></i>
              <span class="slot-level">{{#if this.level}}Lv {{this.level}}{{else}}GP{{/if}}</span>
            </div>
            <div class="slot-main">
              {{#if this.uuid}}
                <a class="slot-name item-link" data-action="openItemSheet" data-uuid="{{this.uuid}}">{{this.name}}</a>
              {{else}}
                <span class="slot-name">{{this.name}}</span>
              {{/if}}
            </div>
            <span class="slot-price">{{this.price}}</span>
            <div class="row-actions">
              <button type="button"
                      class="btn-distribute"
                      data-action="distributeItem"
                      data-category="currency"
                      data-index="{{@index}}"
                      {{#if this.distributed}}disabled{{/if}}>
                {{#if this.distributed}}Distributed{{else}}Distribute{{/if}}
              </button>
              {{#if this.distributed}}
                <button type="button"
                        class="btn-undo"
                        title="Undo distribution"
                        data-action="undoDistributeItem"
                        data-category="currency"
                        data-index="{{@index}}">
                  <i class="fa-solid fa-rotate-left"></i>
                </button>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    </section>

    <!-- Container 4: Fundamental Runes (4 Players per Rune Tier) -->
    <section class="loot-container" data-drop-category="fundamentalRunes">
      <div class="container-header">
        <div class="container-title-group">
          <h3>Fundamental Runes (4 Players)</h3>
          <span class="container-subtitle">Mandatory Weapon Potency, Striking, Armor Potency &amp; Resilient Runes for each of the 4 players</span>
        </div>
      </div>
      {{#if hasFundamentalRunes}}
        <div class="slot-list">
          {{#each levelData.fundamentalRunes}}
            <div class="loot-row {{#if this.distributed}}is-distributed{{/if}}"
                 data-index="{{@index}}"
                 {{#if this.uuid}}draggable="true" data-uuid="{{this.uuid}}"{{/if}}>
              <div class="slot-meta">
                <i class="fa-solid fa-grip-vertical drag-handle" title="Drag to Loot container"></i>
                <span class="slot-level">Lv {{this.level}}</span>
              </div>
              <div class="slot-main">
                {{#if this.uuid}}
                  <a class="slot-name item-link" data-action="openItemSheet" data-uuid="{{this.uuid}}">{{this.name}}</a>
                {{else}}
                  <span class="slot-name">{{this.name}}</span>
                {{/if}}
                <span class="rune-player-tag">{{this.playerLabel}} &middot; {{this.usage}} ({{this.rarity}})</span>
              </div>
              <span class="slot-price">{{this.price}}</span>
              <div class="row-actions">
                <button type="button"
                        class="btn-distribute"
                        data-action="distributeItem"
                        data-category="fundamentalRunes"
                        data-index="{{@index}}"
                        {{#if this.distributed}}disabled{{/if}}>
                  {{#if this.distributed}}Distributed{{else}}Distribute{{/if}}
                </button>
                {{#if this.distributed}}
                  <button type="button"
                          class="btn-undo"
                          title="Undo distribution"
                          data-action="undoDistributeItem"
                          data-category="fundamentalRunes"
                          data-index="{{@index}}">
                    <i class="fa-solid fa-rotate-left"></i>
                  </button>
                {{/if}}
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="empty-section-note">
          No new Fundamental Rune tier unlocks at Level {{activeLevel}}. (Fundamental Runes unlock at Levels 2, 4, 5, 8, 10, 11, 12, 14, 16, 18, 19, and 20).
        </p>
      {{/if}}
    </section>

    <!-- Container 5: Bonus Loot & Extra GP -->
    <section class="loot-container" data-drop-category="bonusLoot">
      <div class="container-header">
        <div class="container-title-group">
          <h3>Bonus Loot &amp; Extra GP</h3>
          <span class="container-subtitle">Drag items from Compendiums here or add custom entries below</span>
        </div>
      </div>
      <div class="bonus-loot-form">
        <input type="text" name="bonusName" placeholder="Item Name or Extra GP (e.g. +1 Returning Dagger or 50 gp)" />
        <input type="text" name="bonusInput" placeholder="Compendium UUID (optional)" />
        <input type="number" name="bonusLevel" min="0" max="20" value="{{activeLevel}}" />
        <button type="button" class="btn-add-bonus" data-action="addBonusLoot">
          <i class="fa-solid fa-plus"></i> Add Bonus Slot
        </button>
      </div>
      <div class="slot-list">
        {{#each levelData.bonusLoot}}
          <div class="loot-row {{#if this.distributed}}is-distributed{{/if}}"
               data-index="{{@index}}"
               {{#if this.uuid}}draggable="true" data-uuid="{{this.uuid}}"{{/if}}>
            <div class="slot-meta">
              <i class="fa-solid fa-grip-vertical drag-handle" title="Drag to Loot container"></i>
              <span class="slot-level">Lv {{this.level}}</span>
            </div>
            <div class="slot-main">
              {{#if this.uuid}}
                <a class="slot-name item-link" data-action="openItemSheet" data-uuid="{{this.uuid}}">{{this.name}}</a>
              {{else}}
                <span class="slot-name">{{this.name}}</span>
              {{/if}}
            </div>
            <span class="slot-price">{{this.price}}</span>
            <div class="row-actions">
              <button type="button"
                      class="btn-distribute"
                      data-action="distributeItem"
                      data-category="bonusLoot"
                      data-index="{{@index}}"
                      {{#if this.distributed}}disabled{{/if}}>
                {{#if this.distributed}}Distributed{{else}}Distribute{{/if}}
              </button>
              {{#if this.distributed}}
                <button type="button"
                        class="btn-undo"
                        title="Undo distribution"
                        data-action="undoDistributeItem"
                        data-category="bonusLoot"
                        data-index="{{@index}}">
                  <i class="fa-solid fa-rotate-left"></i>
                </button>
              {{else}}
                <button type="button"
                        class="btn-remove"
                        title="Remove bonus slot"
                        data-action="removeBonusLoot"
                        data-index="{{@index}}">
                  <i class="fa-solid fa-trash"></i>
                </button>
              {{/if}}
            </div>
          </div>
        {{/each}}
      </div>
    </section>
  </div>
</div>
