.pf2e-treasure-tracker {
  display: flex;
  flex-direction: column;
  gap: 1rem;
  padding: 1rem;
  font-variant-numeric: tabular-nums;
}

.pf2e-treasure-tracker .level-tabs {
  display: grid;
  grid-template-columns: repeat(10, minmax(0, 1fr));
  gap: 0.25rem;
}

.pf2e-treasure-tracker .level-tab.active {
  background: #b45309;
  color: #ffffff;
  font-weight: 600;
}

.pf2e-treasure-tracker .loot-row {
  display: grid;
  grid-template-columns: 4rem 1fr auto auto;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem 0.75rem;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.pf2e-treasure-tracker .loot-row.is-distributed {
  opacity: 0.48;
}

.pf2e-treasure-tracker .loot-row.is-distributed .slot-name,
.pf2e-treasure-tracker .loot-row.is-distributed .slot-uuid {
  text-decoration: line-through;
}

.pf2e-treasure-tracker .loot-row button[disabled] {
  cursor: not-allowed;
  opacity: 0.6;
}
